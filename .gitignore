# Dependências - Nunca envie o node_modules, pois ele é gerado pelo 'npm install'
node_modules/
jspm_packages/

# Segurança e Configurações Sensíveis - ESSENCIAL para proteger suas senhas de banco
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs de Erros - Úteis apenas no seu PC local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
auth.log
*.log

# Pasta de Build/Produção (se você usar frontend como React/Next.js)
dist/
build/
.next/
out/

# Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores de Código e IDEs
.vscode/
.idea/
*.swp
*.swo

# Banco de Dados Local (se houver dumps ou arquivos de lock)
*.sql
*.sqlite